---
/**
 * ProjectTiltCard — hover tilt + glare effect.
 *
 * Formerly a React island hydrated five times per page (each hydration paid
 * the React runtime cost). Now it is plain server-rendered HTML plus one tiny
 * shared script that attaches pointer handlers — zero hydration, zero React.
 * On touch devices the handlers never bind and the card renders as a normal,
 * fully tappable block.
 */
interface Props {
  className?: string;
  isFeatured?: boolean;
}

const { className = "", isFeatured = false } = Astro.props;
---

<div class="tilt-outer h-full w-full" style="perspective: 1000px;">
  <div
    data-tilt
    data-tilt-max={isFeatured ? 5 : 8}
    class={`tilt-inner relative h-full transition-shadow duration-300 rounded-2xl overflow-hidden ${className}`}
  >
    <div
      class="tilt-glare pointer-events-none absolute inset-0 z-20 rounded-2xl opacity-0 transition-opacity duration-300"
      aria-hidden="true"></div>
    <div class="tilt-content relative z-10 h-full">
      <slot />
    </div>
  </div>
</div>

<style>
  .tilt-inner {
    transform-style: preserve-3d;
    transition:
      transform 0.15s ease-out,
      box-shadow 0.3s ease;
  }

  .tilt-content {
    transform: translateZ(16px);
  }

  /* Touch devices get no tilt, so drop the 3D scaffolding entirely there. */
  @media (hover: none), (pointer: coarse) {
    .tilt-outer {
      perspective: none;
    }
    .tilt-inner {
      transform-style: flat;
    }
    .tilt-content {
      transform: none;
    }
  }
</style>

<script>
  // Binds every tilt card once. Only precise pointers get the effect.
  function initTiltCards() {
    if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;

    document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((card) => {
      const glare = card.querySelector<HTMLElement>(".tilt-glare");
      const maxRotation = Number(card.dataset.tiltMax || 8);
      let frame = 0;
      let lastEvent: PointerEvent | null = null;

      const apply = () => {
        frame = 0;
        if (!lastEvent) return;
        const rect = card.getBoundingClientRect();
        const x = lastEvent.clientX - rect.left;
        const y = lastEvent.clientY - rect.top;

        const rX = -((y - rect.height / 2) / (rect.height / 2)) * maxRotation;
        const rY = ((x - rect.width / 2) / (rect.width / 2)) * maxRotation;
        card.style.transform = `rotateX(${rX.toFixed(2)}deg) rotateY(${rY.toFixed(2)}deg)`;

        if (glare) {
          glare.style.background = `radial-gradient(circle 350px at ${(
            (x / rect.width) *
            100
          ).toFixed(1)}% ${((y / rect.height) * 100).toFixed(1)}%, rgba(16, 185, 129, 0.15), transparent 70%)`;
          glare.style.opacity = "1";
        }
      };

      card.addEventListener("pointermove", (event) => {
        if (event.pointerType !== "mouse") return;
        lastEvent = event;
        if (!frame) frame = requestAnimationFrame(apply);
      });

      card.addEventListener("pointerleave", () => {
        lastEvent = null;
        if (frame) {
          cancelAnimationFrame(frame);
          frame = 0;
        }
        card.style.transform = "";
        if (glare) glare.style.opacity = "0";
      });
    });
  }

  initTiltCards();
</script>

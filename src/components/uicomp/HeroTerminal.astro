---
// Terminal card styled after a cybersecurity identity console with Electric Cyan & Ice Blue theme
---

<div
  class="w-full max-w-xl mx-auto rounded-2xl overflow-hidden border border-zinc-800/80 bg-[#080d16]/95 backdrop-blur-xl shadow-[0_20px_50px_rgba(0,0,0,0.7),0_0_35px_rgba(0,240,255,0.08)] transition-all duration-300 hover:border-cyan-500/40 hover:shadow-[0_20px_60px_rgba(0,0,0,0.85),0_0_45px_rgba(0,240,255,0.15)] select-text"
  role="region"
  aria-label="Interactive Terminal Identity"
>
  <!-- Window Header / Title Bar -->
  <div class="px-4 sm:px-5 py-3 bg-[#0d1322]/90 border-b border-zinc-800/80 flex items-center justify-between select-none">
    <!-- Window Control Buttons (traffic lights) -->
    <div class="flex items-center gap-2">
      <span class="w-3 h-3 rounded-full bg-[#f87171] inline-block shadow-[0_0_8px_rgba(248,113,113,0.4)]"></span>
      <span class="w-3 h-3 rounded-full bg-[#38bdf8] inline-block shadow-[0_0_8px_rgba(56,189,248,0.4)]"></span>
      <span class="w-3 h-3 rounded-full bg-[#00f0ff] inline-block shadow-[0_0_8px_rgba(0,240,255,0.4)]"></span>
    </div>

    <!-- Center Window Title with Padlock -->
    <div class="flex items-center gap-2 text-zinc-300 font-mono text-xs sm:text-[13px] font-medium tracking-wide">
      <svg
        class="w-3.5 h-3.5 text-zinc-400 shrink-0"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      <span>terminal@devsecops: ~/identity</span>
    </div>

    <!-- Balanced Spacer on Right -->
    <div class="w-11" aria-hidden="true"></div>
  </div>

  <!-- Terminal Body -->
  <div class="p-5 sm:p-7 font-mono text-xs sm:text-[13.5px] leading-relaxed space-y-4 sm:space-y-5">
    <!-- Command 1: whoami -->
    <div class="space-y-2">
      <div class="flex items-center gap-2 text-[#00f0ff] font-semibold">
        <span>$</span>
        <span>whoami</span>
      </div>
      <div class="bg-[#050811]/90 border border-white/5 rounded-lg px-4 py-2.5 sm:py-3 text-zinc-200 shadow-inner flex items-center gap-2 flex-wrap">
        <span class="text-zinc-100 font-medium">devsecops.engineer</span>
        <span class="text-zinc-500 font-normal">[UID:0x00]</span>
      </div>
    </div>

    <!-- Command 2: cat capabilities.json -->
    <div class="space-y-2">
      <div class="flex items-center gap-2 text-[#00f0ff] font-semibold">
        <span>$</span>
        <span>cat capabilities.json</span>
      </div>
      <div class="bg-[#050811]/90 border border-white/5 rounded-lg p-4 sm:p-5 shadow-inner text-left">
        <div class="text-zinc-400">[</div>
        <div class="pl-4 sm:pl-6 space-y-1.5 my-1.5">
          <div class="text-[#38bdf8]">"Full-Stack Architecture",</div>
          <div class="text-[#38bdf8]">"Zero-Day & Logic Flaw Auditing",</div>
          <div class="text-[#38bdf8]">"Next.js / Node / Supabase",</div>
          <div class="text-[#38bdf8]">"AuthZ & Cryptography"</div>
        </div>
        <div class="text-zinc-400">]</div>
      </div>
    </div>

    <!-- Command 3: ping -c 1 live-cluster.sys -->
    <div class="space-y-1.5">
      <div class="flex items-center gap-2 text-[#00f0ff] font-semibold">
        <span>$</span>
        <span>ping -c 1 live-cluster.sys</span>
      </div>
      <div class="space-y-1 pt-0.5">
        <p class="text-[#38bdf8]">
          64 bytes from prod-cluster: icmp_seq=1 ttl=58 time=14.2ms
        </p>
        <p class="text-[#00f0ff] font-bold tracking-wide">
          [STATUS: SECURE & STABLE]
        </p>
      </div>
    </div>

    <!-- Command 4: git status -->
    <div class="space-y-2">
      <div class="flex items-center gap-2 text-[#00f0ff] font-semibold">
        <span>$</span>
        <span>git status</span>
      </div>
      <div class="flex items-center justify-between gap-4 pt-0.5 flex-wrap">
        <span class="text-zinc-200">branch main (security checks)</span>
        <span class="px-2.5 py-1 rounded bg-[#032338] border border-[#00f0ff]/40 text-[#00f0ff] font-bold text-xs tracking-wider shadow-[0_0_12px_rgba(0,240,255,0.2)]">
          100% PASS
        </span>
      </div>
    </div>

    <!-- Command 5: Prompt with Blinking Cursor -->
    <div class="flex items-center gap-2 text-[#00f0ff] font-semibold pt-1">
      <span>$</span>
      <span class="inline-block w-2.5 h-4.5 bg-[#00f0ff] animate-[terminal-cursor_1s_steps(2,start)_infinite] shadow-[0_0_10px_rgba(0,240,255,0.7)]"></span>
    </div>
  </div>
</div>

<style>
  @keyframes terminal-cursor {
    0%, 49% {
      opacity: 1;
    }
    50%, 100% {
      opacity: 0;
    }
  }
</style>

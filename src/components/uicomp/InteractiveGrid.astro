---
/**
 * InteractiveGrid - A premium background component
 * Features a CSS grid pattern and a mouse-tracked spotlight glow.
 */
---

<div
  class="interactive-grid-container fixed inset-0 -z-10 overflow-hidden pointer-events-none"
  id="grid-container"
>
  <div class="grid-pattern absolute inset-0"></div>
  <div
    class="spotlight absolute inset-0 opacity-0"
    id="spotlight"
  >
  </div>
</div>

<style>
  .interactive-grid-container {
    mask-image: radial-gradient(circle at 50% 30%, black 40%, transparent 90%);
  }

  .grid-pattern {
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: 0.8;
  }

  .spotlight {
    background: radial-gradient(
      circle var(--radius, 400px) at var(--x, 50%) var(--y, 50%),
      rgba(16, 185, 129, 0.18) 0%,
      rgba(6, 182, 212, 0.08) 45%,
      transparent 75%
    );
  }
</style>

<script>
  const spotlight = document.getElementById("spotlight");

  if (spotlight) {
    const hasFinePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

    const paint = (x: number, y: number, radius: number, opacity: number) => {
      spotlight.style.setProperty("--x", `${x.toFixed(1)}px`);
      spotlight.style.setProperty("--y", `${y.toFixed(1)}px`);
      spotlight.style.setProperty("--radius", `${radius.toFixed(1)}px`);
      spotlight.style.opacity = opacity.toFixed(3);
    };

    if (!hasFinePointer) {
      // Touch devices: no always-on animation loop. Show a static ambient glow
      // and brighten it only while a finger is actually on the screen.
      let touchFrame = 0;
      let fadeTimer: ReturnType<typeof setTimeout> | undefined;

      const showAmbient = () => {
        paint(window.innerWidth / 2, window.innerHeight * 0.3, 220, 0.5);
      };

      const onInteraction = (event: TouchEvent) => {
        if (event.touches.length === 0) return;
        const touch = event.touches[0];
        clearTimeout(fadeTimer);
        if (touchFrame) return;
        touchFrame = requestAnimationFrame(() => {
          touchFrame = 0;
          paint(touch.clientX, touch.clientY, 260, 0.85);
        });
      };

      window.addEventListener("touchstart", onInteraction, { passive: true });
      window.addEventListener("touchmove", onInteraction, { passive: true });
      window.addEventListener("touchend", () => {
        clearTimeout(fadeTimer);
        fadeTimer = setTimeout(showAmbient, 1200);
      }, { passive: true });

      showAmbient();
    } else {
      // Desktop: mouse-tracking glow.
      // Paints statically once on load. The rAF loop starts ONLY when the visitor
      // actually moves the pointer, smoothly lerps, and completely SLEEPS when idle.
      // This eliminates continuous style recalculations during page load and idle time.
      let currentX = window.innerWidth / 2;
      let currentY = window.innerHeight * 0.35;
      let targetX = currentX;
      let targetY = currentY;

      let isMobile = window.innerWidth < 768;
      let currentRadius = isMobile ? 220 : 320;
      let targetRadius = currentRadius;

      let currentOpacity = 0.5;
      let targetOpacity = 0.5;

      let isInteracting = false;
      let animationId: number = 0;
      let isTabVisible = true;
      let lastFrameAt = 0;
      const MIN_FRAME_MS = 33; // ~30 fps cap for smooth soft glow

      window.addEventListener("resize", () => {
        isMobile = window.innerWidth < 768;
      }, { passive: true });

      const animate = (now: number) => {
        if (!isTabVisible) {
          animationId = 0;
          return;
        }

        if (now - lastFrameAt >= MIN_FRAME_MS) {
          lastFrameAt = now;

          const dx = targetX - currentX;
          const dy = targetY - currentY;
          const dr = targetRadius - currentRadius;
          const dop = targetOpacity - currentOpacity;

          currentX += dx * 0.1;
          currentY += dy * 0.1;
          currentRadius += dr * 0.1;
          currentOpacity += dop * 0.1;

          paint(currentX, currentY, currentRadius, currentOpacity);

          // Sleep condition: when close to target and not actively moving mouse
          if (!isInteracting && Math.abs(dx) < 0.5 && Math.abs(dy) < 0.5 && Math.abs(dop) < 0.01) {
            paint(targetX, targetY, targetRadius, targetOpacity);
            animationId = 0;
            return; // Loop sleeps! Zero CPU, zero style recalculation
          }
        }

        animationId = requestAnimationFrame(animate);
      };

      const startLoop = () => {
        if (!animationId && isTabVisible) {
          animationId = requestAnimationFrame(animate);
        }
      };

      window.addEventListener("mousemove", (event) => {
        isInteracting = true;
        targetX = event.clientX;
        targetY = event.clientY;
        targetOpacity = 0.85;
        targetRadius = isMobile ? 260 : 380;
        startLoop();
      }, { passive: true });

      window.addEventListener("mouseleave", () => {
        isInteracting = false;
        targetOpacity = 0.45;
        targetRadius = isMobile ? 200 : 300;
        startLoop();
      }, { passive: true });

      // Pause/Resume loop on tab visibility changes
      document.addEventListener("visibilitychange", () => {
        isTabVisible = !document.hidden;
        if (!isTabVisible && animationId) {
          cancelAnimationFrame(animationId);
          animationId = 0;
        }
      });

      // Paint static resting glow once on load — zero ongoing loop during critical page load
      paint(currentX, currentY, currentRadius, currentOpacity);
    }
  }
</script>

---
import { Download } from "../icons/Download";
import { Github } from "../icons/Github";
---

<header
  id="main-navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 py-4 px-4 sm:px-8 lg:px-12 bg-[#07090e]/85 backdrop-blur-md border-b border-white/5"
>
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
    <!-- Left: Brand / Dynamic Section Indicator (matching project sections) -->
    <div class="flex items-center gap-3 sm:gap-4 shrink-0 min-w-0">
      <a
        href="#home"
        aria-label="Micah Kesiena Home"
        class="font-bold text-sm sm:text-base text-white tracking-tight hover:text-cyan-400 transition-colors shrink-0"
      >
        Micah Kesiena
      </a>

      <span class="text-zinc-600 font-mono text-xs select-none">/</span>

      <div
        id="nav-section-indicator"
        class="flex items-center gap-2 font-mono text-xs tracking-wider min-w-0 truncate select-none transition-all duration-200"
      >
        <span id="nav-section-num" class="text-[#00f0ff] font-semibold transition-transform duration-200 inline-block">01</span>
        <span id="nav-section-title" class="text-zinc-400 uppercase truncate transition-opacity duration-200">IDENTITY</span>
      </div>
    </div>

    <!-- Desktop Navigation Links (Matched directly to portfolio sections with smooth sliding underline) -->
    <nav id="desktop-nav-container" class="relative hidden md:flex items-center gap-6 lg:gap-8 shrink-0">
      <a
        href="#about"
        class="nav-link relative py-1 text-xs sm:text-sm font-medium tracking-wide text-zinc-400 hover:text-white transition-colors duration-200"
        data-section="about"
      >
        <span>About</span>
      </a>

      <a
        href="#stack"
        class="nav-link relative py-1 text-xs sm:text-sm font-medium tracking-wide text-zinc-400 hover:text-white transition-colors duration-200"
        data-section="stack"
      >
        <span>Stack</span>
      </a>

      <a
        href="#projects"
        class="nav-link relative py-1 text-xs sm:text-sm font-medium tracking-wide text-zinc-400 hover:text-white transition-colors duration-200"
        data-section="projects"
      >
        <span>Projects</span>
      </a>

      <a
        href="#client-work"
        class="nav-link relative py-1 text-xs sm:text-sm font-medium tracking-wide text-zinc-400 hover:text-white transition-colors duration-200"
        data-section="client-work"
      >
        <span>Client Work</span>
      </a>

      <a
        href="#contact"
        class="nav-link relative py-1 text-xs sm:text-sm font-medium tracking-wide text-zinc-400 hover:text-white transition-colors duration-200"
        data-section="contact"
      >
        <span>Contact</span>
      </a>

      <!-- Smooth Sliding Active Underline Indicator with Electric Cyan Glow -->
      <div
        id="nav-active-glide"
        class="absolute bottom-0 h-[2px] bg-[#00f0ff] shadow-[0_0_12px_rgba(0,240,255,0.95)] transition-all duration-300 ease-out pointer-events-none opacity-0"
        style="transform: translate3d(0, 0, 0);"
      ></div>

      <!-- Quick Actions (GitHub & Resume) -->
      <div class="flex items-center gap-2 pl-4 border-l border-white/10">
        <a
          href="https://github.com/DevTechMike-Coder"
          target="_blank"
          rel="noopener noreferrer"
          data-magnetic
          aria-label="GitHub Profile (@DevTechMike-Coder)"
          class="text-zinc-400 hover:text-white hover:bg-white/5 p-1.5 rounded-lg transition-colors"
        >
          <Github className="w-4 h-4" />
        </a>

        <a
          href="/Micah_Kesiena_Resume.pdf"
          download
          data-magnetic
          aria-label="Download CV"
          class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-zinc-900/80 px-3.5 py-1.5 text-xs font-mono font-medium text-zinc-200 transition-all hover:bg-zinc-800 hover:border-cyan-500/40 hover:text-cyan-300 hover:shadow-[0_0_15px_rgba(0,240,255,0.25)]"
        >
          <Download className="w-3 h-3 text-cyan-400" />
          <span>Resume</span>
        </a>
      </div>
    </nav>

    <!-- Mobile Menu Toggle Button -->
    <button
      id="mobile-nav-toggle"
      type="button"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      class="md:hidden flex items-center justify-center w-9 h-9 rounded-xl bg-zinc-900/80 border border-white/10 text-zinc-300 hover:text-white focus:outline-none transition-colors"
    >
      <svg id="hamburger-icon" class="w-5 h-5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="close-icon" class="w-5 h-5 hidden transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden mt-3 mx-auto max-w-7xl rounded-2xl bg-zinc-950/95 backdrop-blur-xl border border-white/10 p-5 shadow-2xl transition-all duration-300 font-mono"
  >
    <div class="flex flex-col gap-2">
      <a
        href="#home"
        class="mobile-nav-link text-xs uppercase tracking-wider text-zinc-300 hover:text-[#00f0ff] py-2 border-b border-white/5 transition-colors flex items-center justify-between"
      >
        <span>01 // Home</span>
        <span class="text-zinc-600 text-[10px]">IDENTITY</span>
      </a>
      <a
        href="#about"
        class="mobile-nav-link text-xs uppercase tracking-wider text-zinc-300 hover:text-[#00f0ff] py-2 border-b border-white/5 transition-colors flex items-center justify-between"
      >
        <span>02 // About</span>
        <span class="text-zinc-600 text-[10px]">PROFILE</span>
      </a>
      <a
        href="#stack"
        class="mobile-nav-link text-xs uppercase tracking-wider text-zinc-300 hover:text-[#00f0ff] py-2 border-b border-white/5 transition-colors flex items-center justify-between"
      >
        <span>03 // Stack</span>
        <span class="text-zinc-600 text-[10px]">ECOSYSTEM</span>
      </a>
      <a
        href="#projects"
        class="mobile-nav-link text-xs uppercase tracking-wider text-zinc-300 hover:text-[#00f0ff] py-2 border-b border-white/5 transition-colors flex items-center justify-between"
      >
        <span>04 // Projects</span>
        <span class="text-zinc-600 text-[10px]">DEPLOYMENTS</span>
      </a>
      <a
        href="#client-work"
        class="mobile-nav-link text-xs uppercase tracking-wider text-zinc-300 hover:text-[#00f0ff] py-2 border-b border-white/5 transition-colors flex items-center justify-between"
      >
        <span>05 // Client Work</span>
        <span class="text-zinc-600 text-[10px]">COLLABS</span>
      </a>
      <a
        href="#journey"
        class="mobile-nav-link text-xs uppercase tracking-wider text-zinc-300 hover:text-[#00f0ff] py-2 border-b border-white/5 transition-colors flex items-center justify-between"
      >
        <span>06 // Journey</span>
        <span class="text-zinc-600 text-[10px]">EXPERIENCE</span>
      </a>
      <a
        href="#contact"
        class="mobile-nav-link text-xs uppercase tracking-wider text-zinc-300 hover:text-[#00f0ff] py-2 border-b border-white/5 transition-colors flex items-center justify-between"
      >
        <span>07 // Contact</span>
        <span class="text-zinc-600 text-[10px]">CONNECT</span>
      </a>

      <div class="pt-3 flex items-center gap-3">
        <a
          href="/Micah_Kesiena_Resume.pdf"
          download
          class="flex-1 flex items-center justify-center gap-2 rounded-xl border border-white/10 bg-zinc-900 py-2.5 text-xs font-mono text-zinc-200 hover:bg-zinc-800"
        >
          <Download className="w-3.5 h-3.5 text-cyan-400" />
          <span>Resume</span>
        </a>
        <a
          href="https://github.com/DevTechMike-Coder"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center w-11 h-10 rounded-xl border border-white/10 bg-zinc-900 text-zinc-300 hover:text-white"
        >
          <Github className="w-4 h-4" />
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const navbar = document.getElementById("main-navbar");
  const navContainer = document.getElementById("desktop-nav-container");
  const toggleBtn = document.getElementById("mobile-nav-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const hamburgerIcon = document.getElementById("hamburger-icon");
  const closeIcon = document.getElementById("close-icon");
  const mobileLinks = document.querySelectorAll(".mobile-nav-link");
  const navLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-link");
  const glideIndicator = document.getElementById("nav-active-glide");
  const numEl = document.getElementById("nav-section-num");
  const titleEl = document.getElementById("nav-section-title");

  // Section configuration directly mapped to project sections
  const sections = [
    { id: "home", num: "01", title: "IDENTITY", nav: "" },
    { id: "about", num: "02", title: "ABOUT", nav: "about" },
    { id: "stack", num: "03", title: "TECH STACK", nav: "stack" },
    { id: "projects", num: "04", title: "PROJECTS", nav: "projects" },
    { id: "client-work", num: "05", title: "CLIENT WORK", nav: "client-work" },
    { id: "journey", num: "06", title: "JOURNEY", nav: "about" },
    { id: "contact", num: "07", title: "CONTACT", nav: "contact" },
  ];

  let currentActiveNav = "";

  // Helper to glide the active line indicator smoothly under a target element
  const moveGlideTo = (targetLink: HTMLAnchorElement | null) => {
    if (!glideIndicator || !navContainer) return;
    if (!targetLink) {
      glideIndicator.style.opacity = "0";
      return;
    }

    const containerRect = navContainer.getBoundingClientRect();
    const linkRect = targetLink.getBoundingClientRect();

    const left = linkRect.left - containerRect.left;
    const width = linkRect.width;

    glideIndicator.style.width = `${width}px`;
    glideIndicator.style.transform = `translate3d(${left}px, 0, 0)`;
    glideIndicator.style.opacity = "1";
  };

  // Add hover preview to glide indicator
  navLinks.forEach((link) => {
    link.addEventListener("mouseenter", () => {
      moveGlideTo(link);
    });
  });

  navContainer?.addEventListener("mouseleave", () => {
    const activeEl = document.querySelector<HTMLAnchorElement>(`.nav-link[data-section="${currentActiveNav}"]`);
    moveGlideTo(activeEl);
  });

  // Dynamic scroll handler with smooth section indicator animations
  let lastNum = "";
  const handleScroll = () => {
    if (!navbar) return;
    const scrollY = window.scrollY;

    if (scrollY > 20) {
      navbar.classList.add("bg-[#07090e]/95", "shadow-xl", "py-3");
      navbar.classList.remove("py-4");
    } else {
      navbar.classList.remove("bg-[#07090e]/95", "shadow-xl", "py-3");
      navbar.classList.add("py-4");
    }

    // Determine active section based on scroll offset
    const probe = scrollY + 240;
    let current = sections[0];

    for (const sec of sections) {
      const el = document.getElementById(sec.id);
      if (el) {
        const top = el.offsetTop;
        if (probe >= top) {
          current = sec;
        }
      }
    }

    // Update section indicator with subtle animated transition if changed
    if (numEl && titleEl && current.num !== lastNum) {
      lastNum = current.num;
      numEl.style.transform = "translateY(-4px)";
      numEl.style.opacity = "0.4";
      titleEl.style.opacity = "0.4";

      setTimeout(() => {
        if (numEl && titleEl) {
          numEl.textContent = current.num;
          titleEl.textContent = current.title;
          numEl.style.transform = "translateY(0)";
          numEl.style.opacity = "1";
          titleEl.style.opacity = "1";
        }
      }, 120);
    }

    // Update active nav link state and glide underline
    if (current.nav !== currentActiveNav) {
      currentActiveNav = current.nav;

      let foundActive: HTMLAnchorElement | null = null;
      navLinks.forEach((link) => {
        const targetNav = link.getAttribute("data-section");
        if (targetNav === currentActiveNav) {
          link.classList.add("text-white");
          link.classList.remove("text-zinc-400");
          foundActive = link;
        } else {
          link.classList.remove("text-white");
          link.classList.add("text-zinc-400");
        }
      });

      moveGlideTo(foundActive);
    }
  };

  window.addEventListener("scroll", handleScroll, { passive: true });
  window.addEventListener("resize", () => {
    const activeEl = document.querySelector<HTMLAnchorElement>(`.nav-link[data-section="${currentActiveNav}"]`);
    moveGlideTo(activeEl);
  });
  handleScroll();

  // Mobile menu toggle
  let isMenuOpen = false;
  const toggleMenu = () => {
    isMenuOpen = !isMenuOpen;
    toggleBtn?.setAttribute("aria-expanded", String(isMenuOpen));
    if (isMenuOpen) {
      mobileMenu?.classList.remove("hidden");
      hamburgerIcon?.classList.add("hidden");
      closeIcon?.classList.remove("hidden");
    } else {
      mobileMenu?.classList.add("hidden");
      hamburgerIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
    }
  };

  toggleBtn?.addEventListener("click", toggleMenu);

  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      if (isMenuOpen) toggleMenu();
    });
  });
</script>

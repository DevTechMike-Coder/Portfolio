---
import Layout from "../layouts/Layout.astro";
import InteractiveGrid from "../components/uicomp/InteractiveGrid.astro";
import Hero from "./_components/Hero.astro";
import About from "./_components/About.astro";
import TechStack from "./_components/TechStack.astro";
import Projects from "./_components/Projects.astro";
import Journey from "./_components/Journey.astro";
import GitHubDashboard from "./_components/GitHubDashboard.astro";
import Collaborate from "./_components/Collaborate.astro";
import Footer from "./_components/Footer.astro";
---

<Layout>
  <InteractiveGrid />
  <main class="relative z-10 flex flex-col gap-8 md:gap-16 [&>*]:w-full [&>*]:min-w-0">
    <Hero />
    <About />
    <TechStack />
    <Projects />
    <Journey />
    <GitHubDashboard />
    <Collaborate />
  </main>
  <Footer />
</Layout>

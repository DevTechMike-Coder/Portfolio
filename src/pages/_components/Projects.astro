---
import { Briefcase } from "../../components/icons/BriefCase";
import { ArrowUpRight } from "../../components/icons/ArrowUpRight";
import { projects } from "../../data/projects";
import ProjectCard from "../../components/projects/ProjectCard.astro";

// Top 3 featured spotlight projects matching the exact layout and content in user mockup
const featuredProjects = projects.filter((p) => p.featured);
const otherProjects = projects.filter((p) => !p.featured);
---

<section id="projects" class="pt-28 pb-16 px-4 md:px-10 max-w-7xl mx-auto">
  <!-- Section Title & Controls -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
        <Briefcase className="w-5 h-5" />
      </div>
      <div>
        <span class="text-xs font-mono uppercase tracking-widest text-emerald-400 cursor-default transition-colors hover:text-emerald-300" data-scramble data-scramble-on="both">
          DEPLOYMENTS // {String(projects.length).padStart(2, "0")}
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
          Projects
        </h2>
      </div>
    </div>

    <!-- Right Controls: Filter and Archive link -->
    <div class="flex items-center gap-3 flex-wrap">
      <div class="inline-flex p-1 rounded-full bg-zinc-900/90 border border-zinc-800 text-xs font-mono" role="tablist">
        <button
          type="button"
          id="btn-filter-featured"
          class="project-filter-btn px-3.5 py-1.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 font-medium cursor-pointer transition-all duration-200"
          data-target="featured"
        >
          Featured ({featuredProjects.length})
        </button>
        <button
          type="button"
          id="btn-filter-all"
          class="project-filter-btn px-3.5 py-1.5 rounded-full text-zinc-400 hover:text-zinc-200 border border-transparent font-medium cursor-pointer transition-all duration-200"
          data-target="all"
        >
          All ({projects.length})
        </button>
      </div>

      <a
        href="/projects"
        data-magnetic
        class="group inline-flex items-center gap-2 px-4 py-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-300 hover:text-white text-xs font-mono font-medium tracking-wider transition-all duration-300 shadow-[0_0_15px_rgba(16,185,129,0.15)] hover:shadow-[0_0_20px_rgba(16,185,129,0.3)] w-fit"
      >
        <span>Explore Archive</span>
        <ArrowUpRight className="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 text-emerald-400" />
      </a>
    </div>
  </div>

  <!-- Main Card Grid with Matrix Green Backdrop Lines -->
  <div class="relative rounded-2xl p-[1px] bg-linear-to-b from-emerald-500/20 via-zinc-800/60 to-emerald-500/10 shadow-[0_0_40px_rgba(16,185,129,0.06)]">
    <!-- Subtle digital matrix grid overlay (visible in screenshot background) -->
    <div class="absolute -inset-2 rounded-2xl bg-[radial-gradient(ellipse_at_top,rgba(16,185,129,0.12),transparent_70%)] pointer-events-none"></div>

    <div class="relative rounded-2xl overflow-hidden bg-[#07090d]">
      <!-- FEATURED VIEW: 3-column bordered cards exactly matching screenshot -->
      <div id="grid-featured" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 divide-y md:divide-y-0 lg:divide-x divide-zinc-800/80">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>

      <!-- ALL PROJECTS VIEW: full responsive grid divided cleanly -->
      <div id="grid-all" class="hidden grid-cols-1 md:grid-cols-2 lg:grid-cols-3 divide-y divide-zinc-800/80 md:divide-y-0 gap-px bg-zinc-800/80">
        {projects.map((project) => (
          <ProjectCard project={project} className="bg-[#090b0e]" />
        ))}
      </div>
    </div>
  </div>

  <!-- Terminal Footer Summary Bar -->
  <div class="mt-6 flex flex-col sm:flex-row items-center justify-between gap-3 px-2 text-xs font-mono text-zinc-500">
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>SYSTEM_STATUS // ACTIVE DEPLOYMENTS READY</span>
    </div>
    <div class="text-[11px] text-zinc-500">
      SOURCE_REPO: <span class="text-zinc-400">github.com/DevTechMike-Coder</span>
    </div>
  </div>
</section>

<script>
  function setupProjectFilters() {
    const btnFeatured = document.getElementById("btn-filter-featured");
    const btnAll = document.getElementById("btn-filter-all");
    const gridFeatured = document.getElementById("grid-featured");
    const gridAll = document.getElementById("grid-all");

    if (!btnFeatured || !btnAll || !gridFeatured || !gridAll) return;

    const setFilter = (target: "featured" | "all") => {
      if (target === "featured") {
        gridFeatured.classList.remove("hidden");
        gridFeatured.classList.add("grid");
        gridAll.classList.add("hidden");
        gridAll.classList.remove("grid");

        btnFeatured.className =
          "project-filter-btn px-3.5 py-1.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 font-medium cursor-pointer transition-all duration-200";
        btnAll.className =
          "project-filter-btn px-3.5 py-1.5 rounded-full text-zinc-400 hover:text-zinc-200 border border-transparent font-medium cursor-pointer transition-all duration-200";
      } else {
        gridFeatured.classList.add("hidden");
        gridFeatured.classList.remove("grid");
        gridAll.classList.remove("hidden");
        gridAll.classList.add("grid");

        btnAll.className =
          "project-filter-btn px-3.5 py-1.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 font-medium cursor-pointer transition-all duration-200";
        btnFeatured.className =
          "project-filter-btn px-3.5 py-1.5 rounded-full text-zinc-400 hover:text-zinc-200 border border-transparent font-medium cursor-pointer transition-all duration-200";
      }
    };

    btnFeatured.addEventListener("click", () => setFilter("featured"));
    btnAll.addEventListener("click", () => setFilter("all"));
  }

  setupProjectFilters();
  document.addEventListener("astro:page-load", setupProjectFilters);
</script>

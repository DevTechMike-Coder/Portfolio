---
import { Briefcase } from "../../components/icons/BriefCase";
import { Github } from "../../components/icons/Github";
import { ArrowUpRight } from "../../components/icons/ArrowUpRight";
import { ChevronDown } from "../../components/icons/ChevronDown";
import { Nextjs } from "../../components/icons/Nextjs";
import { Typescript } from "../../components/icons/Typescript";
import { Prisma } from "../../components/icons/Prisma";
import { Postgresql } from "../../components/icons/Postgresql";
import { Tailwind } from "../../components/icons/Tailwind";
import { React as ReactIcon } from "../../components/icons/React";
import ProjectTiltCard from "../../components/3d/ProjectTiltCard.astro";

// Confirmed project records with explicit verified status
const featuredProject = {
  id: "01",
  title: "Vertex Canvas",
  subtitle: "Real-time Developer Kanban & Workflow Orchestrator",
  description:
    "A premium, high-performance workspace and productivity application designed for developers, creators, and teams to map workflows, track tasks, and collaborate in real-time. Built with resilient full-stack architecture, ACID-compliant database models, and strict type safety.",
  status: "COMPLETED",
  tech: ["Next.js", "TypeScript", "Prisma", "PostgreSQL", "Tailwind CSS"],
  liveUrl: "https://vertexcanvas.vercel.app",
  githubUrl: "https://github.com/DevTechMike-Coder/KanbanTool",
};

const secondaryProjects = [
  {
    id: "02",
    title: "Next Hub Ecommerce",
    description:
      "A high-performance e-commerce platform built with Next.js, featuring a seamless shopping experience, reactive state pipelines, and robust backend integration.",
    status: "COMPLETED",
    tech: ["Next.js", "TypeScript", "React", "Tailwind CSS"],
    liveUrl: "https://ecommerce-three-omega-39.vercel.app/",
    githubUrl: "https://github.com/DevTechMike-Coder/Ecommerce",
  },
  {
    id: "03",
    title: "DevSec Scanner CLI",
    description:
      "A security command-line tool that inspects network services for open ports and vulnerable configurations, generating actionable hardening reports.",
    status: "IN PROGRESS",
    tech: ["Python", "Network Protocols", "Security Analysis"],
    liveUrl: null,
    githubUrl: null,
  },
  {
    id: "04",
    title: "Auth Vault",
    description:
      "A hardened authentication microservice extracted from Vertex Canvas: HMAC-signed session tokens, route guarding, and Redis rate-limiting out of the box.",
    status: "PLANNED",
    tech: ["Node.js", "Redis", "Security Middleware"],
    liveUrl: null,
    githubUrl: null,
  },
  {
    id: "05",
    title: "Astro Blog Engine",
    description:
      "A zero-JS markdown/MDX blog engine built on Astro with type-safe content collections, syntax highlighting, and RSS generation.",
    status: "IN PROGRESS",
    tech: ["Astro", "TypeScript", "MDX"],
    liveUrl: null,
    githubUrl: null,
  },
];

const allProjectLogs = [
  { id: "01", name: "VERTEX CANVAS", status: "COMPLETED", type: "Full-Stack Web App" },
  { id: "02", name: "NEXT HUB ECOMMERCE", status: "COMPLETED", type: "Full-Stack Web App" },
  { id: "03", name: "DEVSEC SCANNER CLI", status: "IN PROGRESS", type: "Security CLI Tool" },
  { id: "04", name: "AUTH VAULT", status: "PLANNED", type: "Security Microservice" },
  { id: "05", name: "ASTRO BLOG ENGINE", status: "IN PROGRESS", type: "Web Architecture" },
];
---

<section id="projects" class="pt-28 pb-16 px-4 md:px-10 max-w-7xl mx-auto">
  <!-- Section Title -->
  <div class="flex items-center gap-3 mb-8">
    <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
      <Briefcase className="w-5 h-5" />
    </div>
    <div>
      <span class="text-xs font-mono uppercase tracking-widest text-emerald-400">DEPLOYMENTS // 04</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">Featured Projects</h2>
    </div>
  </div>

  <!-- FEATURED PROJECT: Larger Interactive Presentation with Browser Device Frame -->
  <div class="mb-14">
    <ProjectTiltCard isFeatured className="border border-white/15 bg-zinc-900/80 shadow-2xl backdrop-blur-xl">
      <div class="p-6 sm:p-10 flex flex-col gap-6">
        <!-- Futuristic Browser Header -->
        <div class="flex items-center justify-between border-b border-white/10 pb-4">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
            <span class="ml-2 px-3 py-1 rounded-full bg-zinc-950/80 border border-white/5 text-[11px] font-mono text-zinc-400 hidden sm:inline-block">
              https://vertexcanvas.vercel.app
            </span>
          </div>

          <div class="flex items-center gap-2">
            <span class="text-[11px] font-mono text-emerald-400 bg-emerald-500/10 border border-emerald-500/30 px-3 py-1 rounded-full">
              STATUS: {featuredProject.status}
            </span>
          </div>
        </div>

        <!-- Featured Project Body -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center pt-2">
          <div class="lg:col-span-7 flex flex-col gap-4">
            <span class="text-xs font-mono text-emerald-400 tracking-wider">FEATURED_DEPLOYMENT // 01</span>
            <h3 class="text-3xl sm:text-4xl font-black text-white uppercase tracking-tight">
              {featuredProject.title}
            </h3>
            <p class="text-sm font-mono text-zinc-300">
              {featuredProject.subtitle}
            </p>
            <p class="text-zinc-400 text-sm sm:text-base leading-relaxed">
              {featuredProject.description}
            </p>

            <!-- Tech Badges -->
            <div class="flex flex-wrap gap-2 pt-2">
              {
                featuredProject.tech.map((t) => (
                  <span class="px-3 py-1 rounded-lg bg-zinc-950/80 border border-white/10 text-xs font-mono text-zinc-300">
                    {t}
                  </span>
                ))
              }
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-wrap items-center gap-4 pt-4">
              <a
                href={featuredProject.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-full bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-bold px-6 py-3 text-sm min-h-[44px] transition-all shadow-[0_0_20px_rgba(16,185,129,0.3)]"
              >
                Launch Demo
                <ArrowUpRight className="w-4 h-4" />
              </a>

              <a
                href={featuredProject.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-full border border-white/15 bg-zinc-900 hover:bg-zinc-800 text-white font-medium px-6 py-3 text-sm min-h-[44px] transition-all"
              >
                <Github className="w-4 h-4" />
                Source Code
              </a>
            </div>
          </div>

          <!-- Futuristic Preview Frame Graphic -->
          <div class="lg:col-span-5 rounded-2xl bg-zinc-950/90 border border-white/10 p-6 flex flex-col justify-between h-full min-h-[260px] relative overflow-hidden shadow-inner">
            <div class="absolute inset-0 bg-linear-to-br from-emerald-500/10 via-transparent to-cyan-500/10 pointer-events-none"></div>
            
            <div class="flex items-center justify-between font-mono text-xs text-zinc-400 z-10">
              <span>SYSTEM: KANBAN_CORE</span>
              <span class="text-emerald-400">ONLINE</span>
            </div>

            <div class="my-auto py-6 flex flex-col items-center justify-center text-center z-10 gap-3">
              <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center font-mono font-extrabold text-2xl text-emerald-400 shadow-[0_0_25px_rgba(16,185,129,0.2)]">
                VC
              </div>
              <span class="text-white font-bold text-lg tracking-wide">Workspace & Workflow Canvas</span>
              <span class="text-xs font-mono text-zinc-400 max-w-xs">Full-stack React & Next.js realtime collaborative board</span>
            </div>

            <div class="flex items-center justify-between text-[11px] font-mono text-zinc-400 border-t border-white/5 pt-3 z-10">
              <span>LATENCY: 18ms</span>
              <span>SECURITY: STRICT</span>
            </div>
          </div>
        </div>
      </div>
    </ProjectTiltCard>
  </div>

  <!-- SECONDARY PROJECT CARDS: 3D Tilt Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
    {
      secondaryProjects.map((p) => (
        <ProjectTiltCard className="border border-white/10 bg-zinc-900/60 shadow-xl backdrop-blur-md">
          <div class="p-6 sm:p-7 flex flex-col justify-between h-full gap-5">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-mono text-zinc-400">ID // {p.id}</span>
                <span
                  class={`px-2.5 py-0.5 rounded-full text-[10px] font-mono tracking-wider ${
                    p.status === "COMPLETED"
                      ? "bg-emerald-500/10 text-emerald-300 border border-emerald-500/30"
                      : p.status === "IN PROGRESS"
                      ? "bg-amber-500/10 text-amber-300 border border-amber-500/30"
                      : "bg-zinc-800 text-zinc-400 border border-zinc-700"
                  }`}
                >
                  {p.status}
                </span>
              </div>

              <h4 class="text-xl sm:text-2xl font-bold text-white uppercase tracking-tight">
                {p.title}
              </h4>

              <p class="text-zinc-400 text-sm leading-relaxed mt-2.5">
                {p.description}
              </p>
            </div>

            <div>
              <!-- Tech Badges -->
              <div class="flex flex-wrap gap-1.5 mb-5">
                {p.tech.map((t) => (
                  <span class="px-2.5 py-0.5 rounded-md bg-zinc-950/80 border border-white/5 text-[11px] font-mono text-zinc-300">
                    {t}
                  </span>
                ))}
              </div>

              <!-- Links if available -->
              <div class="flex items-center justify-between border-t border-white/5 pt-4">
                {p.githubUrl ? (
                  <a
                    href={p.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center w-11 h-11 -my-2 -ml-2 rounded-xl text-zinc-400 hover:text-white hover:bg-white/5 transition-colors"
                    aria-label={`View ${p.title} source on GitHub`}
                  >
                    <Github className="w-5 h-5" />
                  </a>
                ) : (
                  <span class="text-xs font-mono text-zinc-400 italic">Codebase in staging</span>
                )}

                {p.liveUrl ? (
                  <a
                    href={p.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 min-h-[44px] text-sm font-mono text-emerald-400 hover:text-emerald-300 hover:bg-emerald-500/10 font-medium transition-colors"
                  >
                    Live Preview
                    <ArrowUpRight className="w-4 h-4" />
                  </a>
                ) : (
                  <span class="text-xs font-mono text-zinc-400">Internal tool</span>
                )}
              </div>
            </div>
          </div>
        </ProjectTiltCard>
      ))
    }
  </div>

  <!-- PROJECT_LOG: Terminal Inspired Interface -->
  <div class="p-6 sm:p-8 rounded-3xl bg-zinc-950 border border-white/10 font-mono shadow-2xl relative overflow-hidden">
    <div class="flex items-center justify-between border-b border-zinc-800 pb-4 mb-6">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
        <h3 class="text-base sm:text-lg font-bold text-zinc-100 tracking-wider">PROJECT_LOG.sh</h3>
      </div>
      <span class="text-xs text-zinc-400">SYS_BUILD_VER: 2026.1</span>
    </div>

    <div class="space-y-4">
      <div class="text-xs text-emerald-400/80 mb-2">
        ──────────────────────────────────────────────────────────────────────────
      </div>

      <div class="grid grid-cols-12 gap-2 text-xs font-bold text-zinc-400 border-b border-zinc-900 pb-2 min-w-0">
        <span class="col-span-2 sm:col-span-1 min-w-0 truncate">INDEX</span>
        <span class="col-span-6 sm:col-span-6 min-w-0 truncate">PROJECT_NAME</span>
        <span class="col-span-4 sm:col-span-3 min-w-0 truncate text-right sm:text-left">STATUS</span>
        <span class="hidden sm:inline-block sm:col-span-2 min-w-0 truncate text-right">TYPE</span>
      </div>

      {
        allProjectLogs.map((log) => (
          <div class="grid grid-cols-12 gap-2 text-xs py-2 border-b border-zinc-900/80 hover:bg-zinc-900/50 px-2 rounded-lg transition-colors items-center min-w-0">
            <span class="col-span-2 sm:col-span-1 text-zinc-400 min-w-0 truncate">{log.id}</span>
            <span class="col-span-6 sm:col-span-6 font-bold text-zinc-200 min-w-0 truncate">
              {log.name}
            </span>
            <span class="col-span-4 sm:col-span-3 min-w-0 text-right sm:text-left">
              <span
                class={`inline-block max-w-full truncate align-middle px-2 py-0.5 rounded-sm text-[10px] uppercase font-bold tracking-wider ${
                  log.status === "COMPLETED"
                    ? "text-emerald-400 bg-emerald-500/10 border border-emerald-500/20"
                    : log.status === "IN PROGRESS"
                    ? "text-amber-400 bg-amber-500/10 border border-amber-500/20"
                    : "text-zinc-400 bg-zinc-800"
                }`}
              >
                {log.status}
              </span>
            </span>
            <span class="hidden sm:inline-block sm:col-span-2 min-w-0 text-right text-zinc-400 text-[11px] truncate">
              {log.type}
            </span>
          </div>
        ))
      }

      <div class="text-xs text-zinc-400 pt-2 flex items-center justify-between">
        <span>&gt; END_OF_LOG -- Total Active Records: 05</span>
        <span class="text-emerald-400 animate-pulse">■</span>
      </div>
    </div>
  </div>
</section>

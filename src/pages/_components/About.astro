---
import { User } from "../../components/icons/User";
import { Keyboard } from "../../components/icons/KeyBoard";
import { Timer } from "../../components/icons/Timer";
import { Accuracy } from "../../components/icons/Accuracy";
import { Globe } from "../../components/icons/Globe";
import { Availability } from "../../components/icons/Availability";
import SecurityCoreScene from "../../components/3d/SecurityCoreScene";
---

<section id="about" class="pt-28 pb-16 px-4 md:px-10 max-w-7xl mx-auto">
  <!-- Section Title -->
  <div class="flex items-center gap-3 mb-10 about-fade">
    <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
      <User className="w-5 h-5" />
    </div>
    <div>
      <span class="text-xs font-mono uppercase tracking-widest text-emerald-400">SYS_IDENTITY // 01</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">About Me</h2>
    </div>
  </div>

  <!-- Split Layout: Left Content & Stats, Right 3D Security Core -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
    <!-- Left Column: Bio, Philosophy, Pillars, Typing Speed -->
    <div class="lg:col-span-7 flex flex-col gap-6">
      <!-- Main Bio Card -->
      <div class="about-card p-6 sm:p-8 rounded-3xl bg-zinc-900/60 border border-white/10 backdrop-blur-md relative overflow-hidden shadow-xl">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-white/5 pb-4">
          <span class="text-xs font-mono uppercase tracking-wider text-zinc-400">PROFILE_SUMMARY</span>
          <!-- Live Clock Pill -->
          <div class="flex items-center gap-2 px-3 py-1 rounded-full border border-emerald-500/30 bg-emerald-500/10 text-emerald-300 text-xs font-mono">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
            </span>
            <Availability className="w-3.5 h-3.5" />
            <span id="live-clock" class="tabular-nums">--:--:--</span>
          </div>
        </div>

        <div class="mt-5 space-y-4">
          <p class="text-zinc-200 text-base sm:text-lg leading-relaxed">
            I'm a <strong class="text-emerald-400 font-semibold">Security Focused Full Stack Developer</strong> and <strong class="text-cyan-400 font-semibold">Penetration Tester</strong> who specializes in crafting high-performance, accessible, and secure web applications.
          </p>
          <p class="text-zinc-400 text-sm sm:text-base leading-relaxed">
            From architecting modern reactive frontends to hardening server-side APIs and conducting penetration tests, innovation begins with resilience. I engineer software that protects user data without compromising speed or user experience.
          </p>
        </div>

        <!-- Dev Philosophy -->
        <div class="mt-6 p-4 rounded-2xl bg-zinc-950/70 border border-white/5 flex flex-col gap-1">
          <span class="text-[10px] font-mono text-emerald-400 tracking-widest uppercase">CORE_PHILOSOPHY</span>
          <p class="text-sm sm:text-base font-mono font-semibold text-zinc-200">
            "Move fast, break nothing — patch what you break."
          </p>
        </div>
      </div>

      <!-- Small Statistics & Core Pillars (Genuine, non-fabricated) -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
        <div class="p-4 rounded-2xl bg-zinc-900/40 border border-white/5 backdrop-blur-md flex flex-col gap-1">
          <span class="text-[11px] font-mono text-emerald-400 uppercase tracking-wider">PILLAR_01</span>
          <span class="text-sm font-bold text-white leading-snug">Full Stack</span>
          <span class="text-xs text-zinc-400">End-to-end architecture</span>
        </div>

        <div class="p-4 rounded-2xl bg-zinc-900/40 border border-white/5 backdrop-blur-md flex flex-col gap-1">
          <span class="text-[11px] font-mono text-cyan-400 uppercase tracking-wider">PILLAR_02</span>
          <span class="text-sm font-bold text-white leading-snug">Security</span>
          <span class="text-xs text-zinc-400">Vulnerability & PenTesting</span>
        </div>

        <div class="p-4 rounded-2xl bg-zinc-900/40 border border-white/5 backdrop-blur-md flex flex-col gap-1">
          <span class="text-[11px] font-mono text-indigo-400 uppercase tracking-wider">PILLAR_03</span>
          <span class="text-sm font-bold text-white leading-snug">Modern Web</span>
          <span class="text-xs text-zinc-400">React, Next.js & Astro</span>
        </div>

        <div class="p-4 rounded-2xl bg-zinc-900/40 border border-white/5 backdrop-blur-md flex flex-col gap-1">
          <span class="text-[11px] font-mono text-amber-400 uppercase tracking-wider">PILLAR_04</span>
          <span class="text-sm font-bold text-white leading-snug">Performance</span>
          <span class="text-xs text-zinc-400">Zero-bloat optimization</span>
        </div>
      </div>

      <!-- Typing Speed Metric Card -->
      <div class="p-5 rounded-2xl bg-zinc-900/60 border border-white/10 backdrop-blur-md flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-zinc-800/80 border border-white/5 flex items-center justify-center text-emerald-400">
            <Keyboard className="w-5 h-5" />
          </div>
          <div>
            <span class="text-xs font-mono uppercase text-zinc-400 block">Typing Benchmark</span>
            <div class="flex items-baseline gap-1.5">
              <span class="text-2xl font-bold text-white font-mono">50</span>
              <span class="text-xs font-mono text-zinc-400">WPM</span>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-zinc-950/60 border border-white/10 text-xs font-mono text-zinc-300">
            <Timer className="w-3.5 h-3.5 text-amber-400" />
            <span>15s</span>
          </div>
          <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-zinc-950/60 border border-white/10 text-xs font-mono text-zinc-300">
            <Accuracy className="w-3.5 h-3.5 text-emerald-400" />
            <span>99% Acc</span>
          </div>
          <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-zinc-950/60 border border-white/10 text-xs font-mono text-zinc-300">
            <Globe className="w-3.5 h-3.5 text-cyan-400" />
            <span>EN</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Interactive 3D Security Element -->
    <div class="lg:col-span-5 flex flex-col justify-between p-6 rounded-3xl bg-zinc-900/50 border border-white/10 backdrop-blur-md relative overflow-hidden">
      <div class="flex items-center justify-between z-10">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
          <span class="text-xs font-mono text-zinc-300 uppercase tracking-wider">CRYPTOGRAPHIC_CORE</span>
        </div>
        <span class="text-[10px] font-mono text-emerald-400 border border-emerald-500/30 px-2.5 py-0.5 rounded-full bg-emerald-500/5">
          ACTIVE_SYSTEM
        </span>
      </div>

      <!-- Hydrate near the viewport; mount the canvas only while actually visible. -->
      <div class="w-full flex items-center justify-center my-4">
        <SecurityCoreScene client:visible={{ rootMargin: "150px" }} />
      </div>

      <div class="p-3.5 rounded-xl bg-zinc-950/60 border border-white/5 z-10">
        <div class="flex items-center justify-between text-xs font-mono text-zinc-400">
          <span>THREAT_LEVEL: ZERO</span>
          <span class="text-emerald-400">INTEGRITY: 100%</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    const clockEl = document.getElementById("live-clock");
    if (!clockEl) return;
    function tick() {
      const now = new Date();
      clockEl!.textContent = now.toLocaleTimeString("en-US", {
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: true,
      });
    }
    tick();
    setInterval(tick, 1000);
  })();
</script>

<script>
  import { revealOnScroll } from "../../lib/reveal";
  revealOnScroll(document.querySelectorAll(".about-card"), {
    stagger: 0.12,
    y: 24,
    hideOnExit: true,
  });
</script>

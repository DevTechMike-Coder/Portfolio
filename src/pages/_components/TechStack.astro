---
import { Layers } from "../../components/icons/Layers";
import TechNetworkScene from "../../components/3d/TechNetworkScene";
---

<section id="stack" class="pt-28 pb-16 px-4 md:px-10 max-w-7xl mx-auto">
  <!-- Section Title -->
  <div class="flex items-center gap-3 mb-6">
    <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400">
      <Layers className="w-5 h-5" />
    </div>
    <div>
      <span class="text-xs font-mono uppercase tracking-widest text-cyan-400 cursor-default transition-colors hover:text-cyan-300" data-scramble data-scramble-on="both">SYS_ARCHITECTURE // 03</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">Tech Ecosystem</h2>
    </div>
  </div>

  <p class="text-zinc-400 text-sm sm:text-base max-w-2xl mb-8">
    An interactive 3D topology of modern frameworks, type systems, and database engines. Hover and explore the connected nodes to inspect system architecture.
  </p>

  <!-- 3D Tech Network Canvas Container -->
  <div class="rounded-3xl bg-zinc-900/40 border border-white/10 p-4 sm:p-8 backdrop-blur-md relative overflow-hidden shadow-2xl">
    <div class="absolute inset-0 bg-radial from-cyan-500/5 via-transparent to-transparent pointer-events-none"></div>
    <TechNetworkScene client:visible={{ rootMargin: "150px" }} />
  </div>
</section>

---
import { Github } from "../../../components/icons/Github";
import { ArrowUpRight } from "../../../components/icons/ArrowUpRight";

export type TechItem = {
  name: string;
  icon: any;
};

interface Props {
  title: string;
  description: string;
  tech: TechItem[];
  live: string;
  github?: string;
  /** Two-letter monogram shown in the placeholder preview until a real screenshot exists. */
  monogram: string;
  /** Tailwind gradient classes for the preview panel, e.g. "from-emerald-400 via-teal-500 to-cyan-600". */
  gradient: string;
}

const { title, description, tech, live, github, monogram, gradient } =
  Astro.props as Props;
---

<article
  class="project-card group relative overflow-hidden rounded-2xl border border-white/10 bg-zinc-900/60 backdrop-blur-xl shadow-xl transition-all duration-500 hover:-translate-y-1 hover:border-emerald-500/40 hover:shadow-2xl hover:shadow-emerald-500/10"
>
  <div class="flex flex-col md:flex-row">
    <!-- Preview panel -->
    <div
      class={`relative h-52 w-full shrink-0 overflow-hidden bg-linear-to-br md:h-auto md:w-[38%] ${gradient}`}
    >
      <div
        class="absolute inset-0 opacity-25 mix-blend-overlay [background-image:radial-gradient(circle_at_1px_1px,white_1px,transparent_0)] [background-size:16px_16px]"
      >
      </div>
      <div class="absolute inset-0 bg-black/15"></div>
      <div class="absolute inset-0 flex items-center justify-center">
        <span
          class="font-[var(--font-bauhaus)] text-6xl sm:text-7xl font-black tracking-tighter text-white drop-shadow-[0_4px_16px_rgba(0,0,0,0.4)]"
        >
          {monogram}
        </span>
      </div>
      <span
        class="absolute top-3 left-3 flex items-center gap-1.5 rounded-full border border-white/25 bg-black/50 px-2.5 py-1 text-[11px] font-mono font-medium text-emerald-300 backdrop-blur-md"
      >
        <span class="relative flex h-1.5 w-1.5">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"
          ></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-400"
          ></span>
        </span>
        Live Build
      </span>
    </div>

    <!-- Content -->
    <div class="flex flex-1 flex-col justify-between gap-5 p-6 sm:p-8">
      <div class="space-y-3">
        <div class="flex items-start justify-between gap-3">
          <h2
            class="text-2xl sm:text-3xl font-bold tracking-tight text-white transition-colors duration-300 group-hover:text-emerald-400"
          >
            {title}
          </h2>
          {
            github && (
              <a
                href={github}
                target="_blank"
                rel="noopener noreferrer"
                class="shrink-0 p-2 rounded-xl text-zinc-400 hover:text-white hover:bg-white/5 transition-all"
                aria-label={`View ${title} source on GitHub`}
              >
                <Github className="h-5 w-5" />
              </a>
            )
          }
        </div>

        <p class="text-sm leading-relaxed text-zinc-300">
          {description}
        </p>
      </div>

      <div class="space-y-4">
        <div class="h-px w-full bg-linear-to-r from-white/10 via-white/5 to-transparent">
        </div>

        <div>
          <p class="mb-2 text-xs font-mono font-medium tracking-wider text-zinc-400 uppercase">
            Tech Stack
          </p>
          <div class="flex flex-wrap gap-2">
            {
              tech.map((t) => (
                <span class="flex items-center gap-1.5 rounded-lg border border-white/10 bg-zinc-950/80 px-2.5 py-1 text-xs font-mono text-zinc-300 hover:border-white/20 transition-colors">
                  <t.icon className="h-3.5 w-3.5 text-emerald-400" />
                  {t.name}
                </span>
              ))
            }
          </div>
        </div>

        <div class="h-px w-full bg-linear-to-r from-white/10 via-white/5 to-transparent">
        </div>

        <div class="flex items-center justify-between pt-1">
          <span class="text-xs font-mono text-zinc-400 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            DEPLOYED_SYSTEM
          </span>
          <a
            href={live}
            target="_blank"
            rel="noopener noreferrer"
            class="group/link inline-flex items-center gap-1.5 rounded-full bg-emerald-500 hover:bg-emerald-400 text-zinc-950 px-4 py-2 text-xs font-mono font-bold transition-all shadow-[0_0_15px_rgba(16,185,129,0.25)] hover:shadow-[0_0_25px_rgba(16,185,129,0.4)]"
            aria-label={`Open ${title} live link`}
          >
            Open Live
            <ArrowUpRight className="h-3.5 w-3.5 transition-transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5" />
          </a>
        </div>
      </div>
    </div>
  </div>
</article>

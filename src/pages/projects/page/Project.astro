---
import { Button } from "../../../components/reuseComp/Button";
import { ArrowLeft } from "../../../components/icons/ArrowLeft";
import ProjectCard from "../../../components/projects/ProjectCard.astro";
import { projects } from "../../../data/projects";
---

<main class="pt-28 pb-20 px-4 md:px-10 lg:px-20 min-h-screen bg-transparent max-w-7xl mx-auto">
  <a href="/" class="group w-fit block reveal-fade" aria-label="Back to Home">
    <Button
      variant="outline"
      size="sm"
      className="flex items-center gap-2 cursor-pointer border border-white/15 bg-zinc-900/80 text-zinc-200 hover:text-white hover:border-emerald-500/40 hover:bg-zinc-800 backdrop-blur-md rounded-full px-4 py-2 transition-all duration-300 shadow-sm"
    >
      <ArrowLeft
        className="w-4 h-4 transition-transform group-hover:-translate-x-1 text-emerald-400"
      />
      <span class="font-mono text-xs font-semibold uppercase tracking-wider">Back to Home</span>
    </Button>
  </a>

  <div class="mt-10 reveal-fade">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono mb-4">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      DEPLOYMENTS_CATALOG // VERIFIED BUILDS
    </div>
    <h1
      class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white uppercase"
    >
      Projects <span class="bg-linear-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent">Archive</span>
    </h1>
    <p class="text-zinc-400 mt-3 max-w-xl text-sm sm:text-base leading-relaxed">
      A curated collection of production applications, security-focused architectures, and full-stack software deployments.
    </p>
  </div>

  <!-- Projects Grid in User's Desired Format -->
  <div class="mt-12 relative rounded-2xl p-[1px] bg-linear-to-b from-emerald-500/20 via-zinc-800/60 to-emerald-500/10 shadow-[0_0_40px_rgba(16,185,129,0.06)]">
    <div class="relative rounded-2xl overflow-hidden bg-[#07090d]">
      <div id="live-project-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 divide-y md:divide-y-0 gap-px bg-zinc-800/80">
        {
          projects.map((project) => (
            <div class="reveal-fade h-full">
              <ProjectCard project={project} className="bg-[#090b0e]" />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</main>

<script>
  import { revealOnLoad, revealOnScroll } from "../../../lib/reveal";

  revealOnLoad(document.querySelectorAll(".reveal-fade"), {
    stagger: 0.08,
    y: 20,
  });

  const liveGrid = document.getElementById("live-project-grid");
  if (liveGrid) {
    revealOnScroll(Array.from(liveGrid.children), {
      stagger: 0.1,
      y: 24,
      hideOnExit: false,
    });
  }
</script>
